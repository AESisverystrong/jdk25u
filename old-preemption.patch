+/*
+ * @test
+ * @summary Preserve a single Old cycle across repeated Minor preemption
+ * @requires vm.gc.Z & vm.debug
+ * @library /test/lib
+ * @build jdk.test.whitebox.WhiteBox
+ * @run driver jdk.test.lib.helpers.ClassFileInstaller jdk.test.whitebox.WhiteBox
+ * @run driver/timeout=360 gc.z.TestOldPreemption
+ */
+package gc.z;
+
+import java.lang.ref.*;
+import java.nio.file.*;
+import java.util.*;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.regex.*;
+import jdk.test.lib.process.ProcessTools;
+import jdk.test.lib.process.OutputAnalyzer;
+import jdk.test.whitebox.WhiteBox;
+
+public class TestOldPreemption {
+    static volatile Object sink;
+    static volatile boolean running = true;
+    static final AtomicReference<Throwable> failure = new AtomicReference<>();
+    static class Node {
+        final int id;
+        final byte[] data = new byte[256];
+        volatile Object edge;
+        Node(int id) { this.id = id; data[17] = (byte) id; }
+        void check() {
+            if (data[17] != (byte) id) throw new AssertionError("Corrupt node " + id);
+        }
+    }
+    static void check(boolean condition, String message) {
+        if (!condition) throw new AssertionError(message);
+    }
+    public static void main(String[] args) throws Exception {
+        if (args.length != 0) { workload(); return; }
+        Path log = Path.of("old-preemption-stress.log").toAbsolutePath();
+        ProcessBuilder pb = ProcessTools.createLimitedTestJavaProcessBuilder(
+            "-XX:+UseZGC", "-Xms256m", "-Xmx2g", "-XX:+UnlockDiagnosticVMOptions",
+            "-XX:+WhiteBoxAPI", "-Xbootclasspath/a:.",
+            "-XX:ZOldGCThreads=2", "-XX:ZYoungGCThreads=2",
+            "-Xlog:gc*,gc+stats=off,gc+preempt=debug:file=" + log + ":uptimemillis,tid,level,tags",
+            TestOldPreemption.class.getName(), "child");
+        new OutputAnalyzer(pb.start()).shouldHaveExitValue(0).shouldContain("WORKLOAD completed");
+        audit(Files.readAllLines(log));
+    }
+    static void workload() throws Exception {
+        WhiteBox wb = WhiteBox.getWhiteBox();
+        Node[] live = new Node[48000];
+        Node[] dying = new Node[4096];
+        ReferenceQueue<Node> queue = new ReferenceQueue<>();
+        List<Reference<Node>> refs = new ArrayList<>();
+        List<WeakReference<Node>> liveRefs = new ArrayList<>();
+        for (int i = 0; i < live.length; i++) live[i] = new Node(i);
+        for (int i = 0; i < 512; i++) liveRefs.add(new WeakReference<>(live[2 * i + 1]));
+        for (int i = 0; i < dying.length; i++) {
+            dying[i] = new Node(i);
+            refs.add(new WeakReference<>(dying[i], queue));
+            refs.add(new PhantomReference<>(dying[i], queue));
+        }
+        wb.fullGC();
+        for (int i = 0; i < live.length; i += 2) live[i] = null;
+        Arrays.fill(dying, null);
+        wb.setUintxVMFlag("ZOldPreemptionStressDelay", 1L);
+        Thread churn = new Thread(() -> {
+            try {
+                long count = 0;
+                while (running) {
+                    int i = 2 * (int) (count % (live.length / 2)) + 1;
+                    live[i].check();
+                    live[i].edge = new byte[2048];
+                    sink = new byte[4096];
+                    // Keep generating Young garbage throughout reference processing.
+                    // An allocation-stalled producer cannot submit the next Minor.
+                    count++;
+                    Thread.sleep(1);
+                }
+            } catch (Throwable t) { failure.compareAndSet(null, t); }
+        }, "young-garbage");
+        churn.setDaemon(true);
+        churn.start();
+        long started = System.nanoTime();
+        int minors = 0;
+        for (int round = 0; round < 3; round++) {
+            Thread major = new Thread(() -> {
+                try { wb.fullGC(); }
+                catch (Throwable t) { failure.compareAndSet(null, t); }
+            }, "major-request");
+            major.setDaemon(true);
+            major.start();
+            Thread.sleep(10);
+            long deadline = System.nanoTime() + 90_000_000_000L;
+            while (major.isAlive()) {
+                check(System.nanoTime() < deadline, "Major did not finish round " + round);
+                wb.youngGC();
+                minors++;
+                // Repeated forced Minors also consume promotion/page headroom.
+                // Leave enough space/time to reach the reference phase with an
+                // unstalled requester; allocation-stall stress is a separate run.
+                Thread.sleep(20);
+            }
+            major.join();
+            for (int i = 1; i < live.length; i += 2) live[i].check();
+            for (WeakReference<Node> ref : liveRefs) {
+                check(ref.get() != null, "Lost a strongly reachable weak referent");
+                ref.get().check();
+            }
+        }
+        running = false;
+        churn.join();
+        wb.setUintxVMFlag("ZOldPreemptionStressDelay", 0L);
+        if (failure.get() != null) throw new AssertionError("Worker failed", failure.get());
+        check(minors >= 32, "Insufficient Minor requests: " + minors);
+        wb.fullGC();
+        int enqueued = 0;
+        long deadline = System.nanoTime() + 5_000_000_000L;
+        while (enqueued < refs.size() && System.nanoTime() < deadline) {
+            if (queue.remove(20) != null) enqueued++;
+        }
+        check(enqueued == refs.size(), "References not enqueued: " + enqueued + "/" + refs.size());
+        Runtime rt = Runtime.getRuntime();
+        long before = rt.totalMemory() - rt.freeMemory();
+        liveRefs.clear();
+        Arrays.fill(live, null);
+        sink = null;
+        wb.fullGC();
+        long after = rt.totalMemory() - rt.freeMemory();
+        check(after < before, "Old garbage was not reclaimed: " + before + " -> " + after);
+        Reference.reachabilityFence(refs);
+        System.out.println("WORKLOAD completed minors=" + minors + " elapsed_ms=" +
+            (System.nanoTime() - started) / 1_000_000 + " heap_before=" + before + " heap_after=" + after);
+    }
+    record State(long cycle, String phase, long epoch, long marked, long relocated) {}
+    static void audit(List<String> lines) {
+        Pattern state = Pattern.compile("request=(\\d+) Old cycle=(\\d+) phase=(.*?) (all-parked|resume).*?epoch=(\\d+) mark_entries=(\\d+) relocated_pages=(\\d+)");
+        Pattern completed = Pattern.compile("Old cycle=(\\d+) completed");
+        Map<Long, State> parked = new HashMap<>();
+        Map<Long, State> latest = new HashMap<>();
+        Map<Long, Integer> counts = new HashMap<>();
+        Set<Long> finished = new HashSet<>();
+        Set<String> phases = new HashSet<>();
+        for (String line : lines) {
+            Matcher c = completed.matcher(line);
+            if (c.find()) finished.add(Long.parseLong(c.group(1)));
+            Matcher m = state.matcher(line);
+            if (!m.find()) continue;
+            long request = Long.parseLong(m.group(1));
+            State s = new State(Long.parseLong(m.group(2)), m.group(3),
+                Long.parseLong(m.group(5)), Long.parseLong(m.group(6)), Long.parseLong(m.group(7)));
+            if (m.group(4).equals("all-parked")) {
+                check(parked.put(request, s) == null, "Duplicate park " + request);
+                continue;
+            }
+            State p = parked.remove(request);
+            check(p != null, "Resume without park " + request);
+            if (p.phase.equals("Idle")) continue;
+            check(s.cycle == p.cycle && s.epoch == p.epoch, "Cycle/epoch changed during pause " + request);
+            check(s.marked == p.marked, "Mark advanced while parked " + request);
+            check(s.relocated >= p.relocated, "Relocation went backwards during pause " + request);
+            State prev = latest.put(s.cycle, s);
+            if (prev != null) check(s.marked >= prev.marked && s.relocated >= prev.relocated,
+                "Progress went backwards in cycle " + s.cycle);
+            counts.merge(s.cycle, 1, Integer::sum);
+            phases.add(s.phase);
+        }
+        check(parked.isEmpty(), "Unreleased holds " + parked.keySet());
+        check(finished.containsAll(counts.keySet()), "Preempted cycle did not finish " + counts);
+        check(counts.values().stream().anyMatch(n -> n >= 32), "No repeatedly preempted Major " + counts);
+        check(phases.contains("Mark"), "Mark preemption untested " + phases);
+        check(phases.contains("Process Non-Strong"), "Reference preemption untested " + phases);
+        check(phases.contains("Relocate"), "Relocation preemption untested " + phases);
+        System.out.println("PREEMPTION verified pauses=" + counts + " phases=" + phases);
+    }
+}
