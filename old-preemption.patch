diff --git a/preemption/build-windows.sh b/preemption/build-windows.sh
new file mode 100755
index 0000000..a376e37
--- /dev/null
+++ b/preemption/build-windows.sh
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+set -euo pipefail
+# Run on Windows in the Cygwin/MSYS2 environment described by doc/building.md.
+case "$(uname -s)" in CYGWIN*|MSYS*|MINGW*) ;; *) echo 'Requires a native Windows build host' >&2; exit 2;; esac
+: "${JDK_BOOT_HOME:?Set JDK_BOOT_HOME to a Windows x64 JDK 24 or 25}"
+cd "$(dirname "$0")/.."
+level=${DEBUG_LEVEL:-release}
+revision=$(git rev-parse --short HEAD)
+conf="windows-oldpreempt-$level"
+bash configure --with-conf-name="$conf" --with-boot-jdk="$JDK_BOOT_HOME" \
+  --with-debug-level="$level" \
+  --with-jvm-variants=server --with-native-debug-symbols=none \
+  --with-toolchain-version=2022 --disable-javac-server \
+  --with-version-opt="oldpreempt.$revision" "$@"
+make CONF="$conf" JOBS="${JOBS:-4}" images
+
+# Finish the build before touching the image. Do not run make test here: it can
+# rebuild the image during packaging. Only check the deliverable can start.
+image="$PWD/build/$conf/images/jdk"
+for required in bin/java.exe bin/javac.exe bin/server/jvm.dll lib/modules release; do
+  test -s "$image/$required" || { echo "Incomplete JDK: $required" >&2; exit 3; }
+done
+timeout 30s "$image/bin/java.exe" -XX:+UnlockDiagnosticVMOptions \
+  -XX:+UseZGC -XX:+ZOldGCPreemption -version
+
+out="$PWD/build/windows-delivery"
+mkdir -p "$out"
+name="openjdk25u-oldpreempt-windows-x64-$revision-$level-$(date -u +%Y%m%dT%H%M%S)"
+archive="$out/$name.zip"
+test ! -e "$archive"
+(cd "$(dirname "$image")" && zip -q -r "$archive" jdk)
+unzip -tqq "$archive"
+(cd "$out" && sha256sum "$name.zip" > "$name.zip.sha256")
+printf 'Windows JDK ZIP: %s\n' "$archive"
diff --git a/preemption/checkpoint.sh b/preemption/checkpoint.sh
new file mode 100755
index 0000000..7148ac4
--- /dev/null
+++ b/preemption/checkpoint.sh
@@ -0,0 +1,91 @@
+#!/usr/bin/env bash
+# Incremental backups for this Work session. Requires git, GNU tar, flock,
+# timeout, python3 and the supplied authenticated Library upload helper.
+set -euo pipefail
+repo=$(cd "$(dirname "$0")/.." && pwd)
+state=${CHECKPOINT_STATE:-"$repo/../checkpoint-state"}
+helper=${CHECKPOINT_UPLOAD_HELPER:?Set the absolute library_upload.py helper path}
+base=${CHECKPOINT_BASE:-89ebfb04f2d99358d7293f50562740676ef96742}
+mkdir -p "$state"
+state=$(cd "$state" && pwd)
+
+if [[ ${1:---once} == --watch ]]; then
+  while :; do
+    deadline=$(($(date +%s) + 300))
+    timeout 290s bash "$0" --once >> "$state/watch.log" 2>&1 ||
+      printf '%s backup failed; previous acknowledged base retained\n' "$(date -u +%FT%TZ)" >> "$state/watch.log"
+    delay=$((deadline - $(date +%s)))
+    ((delay > 0)) || delay=1
+    sleep "$delay"
+  done
+fi
+[[ ${1:---once} == --once ]] || { echo 'Use --once or --watch' >&2; exit 2; }
+
+exec 9>"$state/lock"
+flock -n 9 || exit 0
+cd "$repo"
+head=$(git rev-parse HEAD)
+previous=$base
+[[ ! -f "$state/acknowledged-head" ]] || previous=$(cat "$state/acknowledged-head")
+git cat-file -e "$previous^{commit}"
+id="openjdk25u-incremental-${head:0:9}-$(date -u +%Y%m%dT%H%M%S%N)"
+stage="$state/$id"
+mkdir "$stage"
+printf '%s\n' "$head" > "$stage/HEAD.txt"
+printf '%s\n' "$previous" > "$stage/PREREQUISITE.txt"
+git show-ref > "$stage/REFS.txt"
+git status --porcelain=v1 -z > "$stage/status.nul"
+git diff --binary HEAD > "$stage/working-tree.patch"
+git ls-files --others --exclude-standard -z > "$stage/untracked.nul"
+tar --null -T "$stage/untracked.nul" -cf "$stage/untracked.tar"
+if [[ "$head" != "$previous" ]]; then
+  timeout 30s git bundle create "$stage/commits.bundle" --all "^$previous"
+  timeout 30s git bundle verify "$stage/commits.bundle" > "$stage/bundle-verification.txt" 2>&1
+  git format-patch --output-directory "$stage/patches" "$previous..$head" > "$stage/patch-list.txt"
+fi
+
+# A live build cache is separate from the consistent source snapshot. Never
+# present an archive with files changing during capture as a usable JDK/cache.
+paths=()
+[[ ! -d build ]] || paths+=(build)
+[[ ! -d preemption/evidence ]] || paths+=(preemption/evidence)
+cache_ok=false
+if ((${#paths[@]})); then
+  [[ ! -f "$state/cache.snar" ]] || cp "$state/cache.snar" "$stage/cache-next.snar"
+  if timeout 90s tar --listed-incremental="$stage/cache-next.snar" \
+      -czf "$stage/build-and-evidence.tar.gz" "${paths[@]}" 2> "$stage/cache-capture.log"; then
+    cache_ok=true
+  else
+    # These are temporary files created by this invocation, never user files.
+    rm -f -- "$stage/build-and-evidence.tar.gz" "$stage/cache-next.snar"
+    printf 'Live cache capture failed; source backup remains valid. Cache base was not advanced.\n' > "$stage/CACHE-DEFERRED.txt"
+  fi
+fi
+
+# Detect concurrent source edits before publishing this checkpoint.
+[[ "$(git rev-parse HEAD)" == "$head" ]] || exit 3
+git diff --binary HEAD > "$stage/working-tree-after.patch"
+cmp "$stage/working-tree.patch" "$stage/working-tree-after.patch"
+printf '%s\n' 'Restore into a separate directory containing the previous acknowledged checkpoint.' \
+  'Verify/fetch commits.bundle, check out HEAD.txt, then apply working-tree.patch and extract untracked.tar.' \
+  'Restore GNU tar incremental build-and-evidence archives in timestamp order only into that recovery directory.' \
+  'A restored build cache requires make validation; it is not a validated JDK distribution.' > "$stage/RESTORE.txt"
+archive="$state/$id.tar.gz"
+timeout 120s tar -czf "$archive" -C "$state" "$id"
+timeout 30s gzip -t "$archive"
+python3 - "$archive" > "$stage/upload.json" <<'PY'
+import json,sys
+json.dump({'uploads':[{'local_path':sys.argv[1],'purpose':'create_library_file'}]},sys.stdout)
+PY
+timeout 180s python3 "$helper" < "$stage/upload.json" > "$stage/upload-result.json"
+python3 - "$stage/upload-result.json" <<'PY'
+import json,sys
+r=json.load(open(sys.argv[1]))['results']
+assert len(r)==1 and r[0]['status']=='succeeded', r
+print('BACKUP SAVED:',r[0]['local_path'])
+PY
+# Advance bases ONLY after the remote upload has acknowledged success.
+printf '%s\n' "$head" > "$state/acknowledged-head.next"
+mv "$state/acknowledged-head.next" "$state/acknowledged-head"
+if $cache_ok; then cp "$stage/cache-next.snar" "$state/cache.snar.next"; mv "$state/cache.snar.next" "$state/cache.snar"; fi
+printf '%s\n' "$archive" > "$state/latest-archive"
