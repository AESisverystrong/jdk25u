+name: Windows Old Preemption JDK
+
+on:
+  push:
+    branches:
+      - pr/old-preemption-windows
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+env:
+  MSYS2_PATH_TYPE: minimal
+  CHERE_INVOKING: 1
+
+jobs:
+  windows:
+    runs-on: windows-2022
+    timeout-minutes: 120
+    steps:
+      - uses: actions/checkout@v6
+      - name: Prepare MSYS2
+        uses: ./.github/actions/get-msys2
+      - name: Download and verify boot JDK
+        id: bootjdk
+        uses: ./.github/actions/get-bootjdk
+        with:
+          platform: windows-x64
+      - name: Build release JDK and package
+        shell: env /usr/bin/bash --login -eo pipefail {0}
+        env:
+          PATH: ''
+          JDK_BOOT_HOME: ${{ steps.bootjdk.outputs.path }}
+          JOBS: '4'
+        run: |
+          mkdir -p build/windows-delivery
+          git rev-parse HEAD > build/windows-delivery/SOURCE-COMMIT.txt
+          bash preemption/build-windows.sh 2>&1 | tee build/windows-delivery/build.log
+      - name: Upload Windows JDK
+        uses: actions/upload-artifact@v6
+        with:
+          name: windows-x64-jdk-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}
+          path: |
+            build/windows-delivery/*.zip
+            build/windows-delivery/*.sha256
+            build/windows-delivery/SOURCE-COMMIT.txt
+          if-no-files-found: error
+          compression-level: 0
+      - name: Preserve build log
+        if: always()
+        uses: actions/upload-artifact@v6
+        with:
+          name: windows-build-log-${{ github.run_id }}-${{ github.run_attempt }}
+          path: build/windows-delivery/build.log
+          if-no-files-found: ignore
