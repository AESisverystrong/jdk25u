@@ -0,0 +1,51 @@
+import java.lang.ref.Reference;
+import java.util.Arrays;
+import java.util.concurrent.atomic.AtomicReference;
+import jdk.test.whitebox.WhiteBox;
+
+/** Identical workload for an unmodified and a patched HotSpot of the same revision. */
+public class LatencyProbe {
+    static volatile Object sink;
+    public static void main(String[] args) throws Exception {
+        WhiteBox wb = WhiteBox.getWhiteBox();
+        Object[] old = new Object[64000];
+        for (int i = 0; i < old.length; i++) old[i] = new byte[512];
+        wb.fullGC();
+        for (int i = 0; i < old.length; i += 2) old[i] = null;
+        long[] majors = new long[8];
+        AtomicReference<Throwable> failure = new AtomicReference<>();
+        Thread driver = new Thread(() -> {
+            try {
+                for (int i = 0; i < majors.length; i++) {
+                    long start = System.nanoTime();
+                    wb.fullGC();
+                    majors[i] = System.nanoTime() - start;
+                    Thread.sleep(5);
+                }
+            } catch (Throwable t) { failure.set(t); }
+        });
+        driver.setDaemon(true);
+        long start = System.nanoTime();
+        long allocated = 0;
+        long[] samples = new long[100000];
+        int count = 0;
+        driver.start();
+        while (driver.isAlive() || count < 200) {
+            if (count == samples.length || System.nanoTime() - start > 180_000_000_000L)
+                throw new AssertionError("Major progress timeout");
+            for (int i = 0; i < 128; i++) { sink = new byte[8192]; allocated += 8192; }
+            long t = System.nanoTime();
+            wb.youngGC();
+            samples[count++] = System.nanoTime() - t;
+        }
+        driver.join();
+        if (failure.get() != null) throw new AssertionError(failure.get());
+        Arrays.sort(samples, 0, count);
+        double seconds = (System.nanoTime() - start) / 1e9;
+        System.out.printf("RESULT samples=%d minor_p50_ms=%.3f minor_p99_ms=%.3f minor_max_ms=%.3f major_mean_ms=%.3f throughput_MiB_s=%.3f%n",
+            count, samples[count / 2] / 1e6, samples[(int) Math.ceil(count * .99) - 1] / 1e6,
+            samples[count - 1] / 1e6, Arrays.stream(majors).average().orElseThrow() / 1e6,
+            allocated / (1024.0 * 1024.0) / seconds);
+        Reference.reachabilityFence(old);
+    }
+}
