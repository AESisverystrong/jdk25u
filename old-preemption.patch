+#ifndef SHARE_GC_Z_ZOLDPREEMPTION_HPP
+#define SHARE_GC_Z_ZOLDPREEMPTION_HPP
+#include "gc/z/zLock.hpp"
+#include "memory/allocation.hpp"
+#include "utilities/globalDefinitions.hpp"
+
+// Old-local participation, independent of STS. Only audited tasks participate.
+class ZOldPreemption : public AllStatic {
+  static ZConditionLock* _lock;
+  static volatile bool _requested;
+  static THREAD_LOCAL bool _joined;
+  static uint _running;
+  static uint _cycle;
+  static uint64_t _request;
+  static uint64_t _pauses;
+  static volatile uint64_t _mark_entries;
+  static volatile uint64_t _relocated_pages;
+  static const char* _phase;
+  static double _requested_at;
+  static double _parked_at;
+  static double _paused_seconds;
+public:
+  static void initialize();
+  static bool joined();
+  static bool requested();
+  static void join();
+  static void leave();
+  static void start();
+  static void end();
+  static void phase(const char* name, bool poll = true);
+  static void poll(bool in_sts);
+  static void mark_progress(size_t entries);
+  static void relocate_progress();
+  static void request();
+  static void resume();
+  static void minor_start();
+  static void minor_end();
+};
+class ZOldPreemptionJoiner : public StackObj {
+  bool _active;
+public:
+  ZOldPreemptionJoiner(bool active) : _active(active) { if (_active) ZOldPreemption::join(); }
+  ~ZOldPreemptionJoiner() { if (_active) ZOldPreemption::leave(); }
+};
+// Destroy after releasing any inner lock, before rejoining an outer STS leaver.
+class ZOldPreemptionLeaver : public StackObj {
+  bool _active;
+public:
+  ZOldPreemptionLeaver() : _active(ZOldPreemption::joined()) { if (_active) ZOldPreemption::leave(); }
+  ~ZOldPreemptionLeaver() { if (_active) ZOldPreemption::join(); }
+};
+class ZOldPreemptionCycle : public StackObj {
+public:
+  ZOldPreemptionCycle() { ZOldPreemption::start(); }
+  ~ZOldPreemptionCycle() { ZOldPreemption::end(); }
+};
+// Construct BEFORE DriverLocker, so resume follows driver unlock.
+class ZOldPreemptionRequest : public StackObj {
+public:
+  ZOldPreemptionRequest() { ZOldPreemption::request(); }
+  ~ZOldPreemptionRequest() { ZOldPreemption::resume(); }
+};
+#endif // SHARE_GC_Z_ZOLDPREEMPTION_HPP
