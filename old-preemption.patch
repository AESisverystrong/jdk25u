+ * 2 along with this work; if not, write to the Free Software Foundation,
+ * Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301 USA.
+ *
+ * Please contact Oracle, 500 Oracle Parkway, Redwood Shores, CA 94065 USA
+ * or visit www.oracle.com if you need additional information or have any
+ * questions.
+ */
+
+#include "gc/shared/gcId.hpp"
+#include "gc/shared/suspendibleThreadSet.hpp"
+#include "gc/z/zAbort.inline.hpp"
+#include "gc/z/zGeneration.inline.hpp"
+#include "gc/z/zHeap.inline.hpp"
+#include "gc/z/zLock.inline.hpp"
+#include "gc/z/zOldPreemption.hpp"
+#include "gc/z/z_globals.hpp"
+#include "logging/log.hpp"
+#include "runtime/atomic.hpp"
+#include "runtime/os.hpp"
+#include "runtime/thread.inline.hpp"
+
+ZConditionLock* ZOldPreemption::_lock = nullptr;
+volatile bool ZOldPreemption::_requested = false;
+THREAD_LOCAL bool ZOldPreemption::_joined = false;
+uint ZOldPreemption::_running = 0;
+uint ZOldPreemption::_cycle = 0;
+uint64_t ZOldPreemption::_request = 0;
+uint64_t ZOldPreemption::_pauses = 0;
+volatile uint64_t ZOldPreemption::_mark_entries = 0;
+volatile uint64_t ZOldPreemption::_relocated_pages = 0;
+const char* ZOldPreemption::_phase = "Idle";
+double ZOldPreemption::_requested_at = 0;
+double ZOldPreemption::_parked_at = 0;
+double ZOldPreemption::_paused_seconds = 0;
+void ZOldPreemption::initialize() { _lock = new ZConditionLock(); }
+bool ZOldPreemption::joined() { return _joined; }
+bool ZOldPreemption::requested() { return Atomic::load(&_requested); }
+void ZOldPreemption::join() {
+  if (!ZOldGCPreemption) return;
+  assert(!_joined, "Nested Old participation");
+  ZLocker<ZConditionLock> locker(_lock);
+  while (_requested) _lock->wait();
+  _running++;
+  _joined = true;
+}
+void ZOldPreemption::leave() {
+  if (!ZOldGCPreemption) return;
+  ZLocker<ZConditionLock> locker(_lock);
+  assert(_joined && _running > 0, "Missing Old participation");
+  _joined = false;
+  _running--;
+  if (_running == 0) _lock->notify_all();
+}
+void ZOldPreemption::start() {
+  join();
+  if (!ZOldGCPreemption) return;
+  ZLocker<ZConditionLock> locker(_lock);
+  _cycle = GCId::current();
+  _pauses = 0;
+  _paused_seconds = 0;
+  Atomic::store(&_mark_entries, uint64_t(0));
+  Atomic::store(&_relocated_pages, uint64_t(0));
+  _phase = "Mark Roots";
+  log_debug(gc, preempt)("Old cycle=%u started epoch=%u", _cycle, ZGeneration::old()->seqnum());
+}
+void ZOldPreemption::end() {
+  if (!ZOldGCPreemption) return;
+  poll(false);
+  {
+    ZLocker<ZConditionLock> locker(_lock);
+    log_debug(gc, preempt)("Old cycle=%u %s pauses=" UINT64_FORMAT " paused=%.3fms mark_entries=" UINT64_FORMAT " relocated_pages=" UINT64_FORMAT,
+                          _cycle, ZAbort::should_abort() ? "shutdown-aborted" : "completed", _pauses,
+                          _paused_seconds * 1000, Atomic::load(&_mark_entries), Atomic::load(&_relocated_pages));
+    _phase = "Idle";
+  }
+  leave();
+}
+void ZOldPreemption::phase(const char* name, bool poll_before) {
+  if (!ZOldGCPreemption) return;
+  if (poll_before) poll(false);
+  ZLocker<ZConditionLock> locker(_lock);
+  _phase = name;
+  log_debug(gc, preempt)("Old cycle=%u phase=%s", _cycle, _phase);
+}
+void ZOldPreemption::poll(bool in_sts) {
+  if (!_joined || (!requested() && ZOldPreemptionStressDelay == 0)) return;
+  // Publish both generations' stacks. Preserve the bitmap and C++ task frame.
+  if (in_sts) ZHeap::heap()->mark_flush(Thread::current());
+  SuspendibleThreadSetLeaver sts_leaver(in_sts);
+  ZLocker<ZConditionLock> locker(_lock);
+  if (!_requested && ZOldPreemptionStressDelay != 0 && Thread::current()->is_Worker_thread()) {
+    _lock->wait(ZOldPreemptionStressDelay);
+  }
+  if (!_requested) return;
+  _running--;
+  log_trace(gc, preempt)("Old cycle=%u phase=%s parked thread=" PTR_FORMAT " at=%.6f",
+                        _cycle, _phase, p2i(Thread::current()), os::elapsedTime());
+  if (_running == 0) _lock->notify_all();
+  while (_requested) _lock->wait();
+  _running++;
+  log_trace(gc, preempt)("Old cycle=%u phase=%s resumed thread=" PTR_FORMAT " at=%.6f",
+                        _cycle, _phase, p2i(Thread::current()), os::elapsedTime());
+}
+void ZOldPreemption::mark_progress(size_t entries) {
+  if (_joined) Atomic::add(&_mark_entries, uint64_t(entries), memory_order_relaxed);
+}
+void ZOldPreemption::relocate_progress() {
+  if (ZOldGCPreemption) Atomic::add(&_relocated_pages, uint64_t(1), memory_order_relaxed);
+}
+void ZOldPreemption::request() {
+  if (!ZOldGCPreemption) return;
+  {
+    ZLocker<ZConditionLock> locker(_lock);
+    assert(!_requested, "Only the Minor driver requests preemption");
+    Atomic::store(&_requested, true);
+    _request++;
+    _requested_at = os::elapsedTime();
+    log_debug(gc, preempt)("request=" UINT64_FORMAT " Old cycle=%u phase=%s requested at=%.6f running=%u",
+                          _request, _cycle, _phase, _requested_at, _running);
+    _lock->notify_all();
+    while (_running != 0) _lock->wait();
+  }
+  // Outside the coordinator lock. In-flight pages must finish; queued
+  // retainers must still be serviced to avoid blocking a safepoint or Young.
+  ZGeneration::old()->synchronize_relocation();
+  {
+    ZLocker<ZConditionLock> locker(_lock);
+    _parked_at = os::elapsedTime();
+    _pauses++;
+    log_debug(gc, preempt)("request=" UINT64_FORMAT " Old cycle=%u phase=%s all-parked at=%.6f wait=%.3fms epoch=%u mark_entries=" UINT64_FORMAT " relocated_pages=" UINT64_FORMAT,
+                          _request, _cycle, _phase, _parked_at, (_parked_at - _requested_at) * 1000,
+                          ZGeneration::old()->seqnum(), Atomic::load(&_mark_entries), Atomic::load(&_relocated_pages));
+  }
+}
+void ZOldPreemption::resume() {
+  if (!ZOldGCPreemption) return;
+  ZGeneration::old()->desynchronize_relocation();
+  ZLocker<ZConditionLock> locker(_lock);
+  const double duration = os::elapsedTime() - _parked_at;
+  _paused_seconds += duration;
+  log_debug(gc, preempt)("request=" UINT64_FORMAT " Old cycle=%u phase=%s resume pause=%.3fms epoch=%u mark_entries=" UINT64_FORMAT " relocated_pages=" UINT64_FORMAT,
+                        _request, _cycle, _phase, duration * 1000, ZGeneration::old()->seqnum(),
+                        Atomic::load(&_mark_entries), Atomic::load(&_relocated_pages));
+  Atomic::store(&_requested, false);
+  _lock->notify_all();
+}
+void ZOldPreemption::minor_start() {
+  if (ZOldGCPreemption) log_debug(gc, preempt)("request=" UINT64_FORMAT " Minor start", _request);
+}
+void ZOldPreemption::minor_end() {
+  if (ZOldGCPreemption) log_debug(gc, preempt)("request=" UINT64_FORMAT " Minor end", _request);
+}
